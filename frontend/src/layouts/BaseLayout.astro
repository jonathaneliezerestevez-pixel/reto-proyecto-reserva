---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Reserva tu mesa para una noche memorable.' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="grain min-h-screen">
    <slot />
  </body>
</html>
