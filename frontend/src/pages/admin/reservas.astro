---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Brand from '../../components/layout/Brand.astro'
---

<BaseLayout title="Panel de reservas">
  <main class="min-h-screen bg-[#fff8df] text-[#39152f]">
    <header class="border-b border-[#e5cdd7] bg-[#39152f] text-[#fff8df]">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10"><Brand /><div class="flex items-center gap-4"><span id="admin-name" class="hidden text-sm text-[#d5b9ca] sm:inline"></span><button id="logout" class="focus-ring rounded-full border border-[#fff8df]/40 px-4 py-2 text-xs uppercase tracking-wider hover:bg-[#fff8df] hover:text-[#39152f]">Cerrar sesión</button></div></div>
    </header>
    <section class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="text-xs font-bold uppercase tracking-[0.3em] text-[#9a587d]">Administración</p><h1 class="mt-2 text-5xl font-medium">Tus reservas</h1><p class="mt-2 text-[#81576d]">Consulta y organiza las mesas de tu restaurante.</p></div><button id="new-reservation" class="focus-ring rounded-lg bg-[#67254e] px-5 py-3 font-semibold text-[#fff8df] hover:bg-[#501d41]">+ Nueva reserva</button></div>
      <details class="mt-8 rounded-xl border border-[#e5cdd7] bg-white/60"><summary class="cursor-pointer px-5 py-4 font-semibold">Editar información pública del restaurante</summary><form id="restaurant-form" class="grid gap-4 border-t border-[#e5cdd7] p-5 sm:grid-cols-2"><label class="text-sm">Nombre<input name="Nombre" required class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Tipo de comida<input name="TipoComida" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm sm:col-span-2">Descripción<textarea name="Descripcion" rows="3" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2"></textarea></label><label class="text-sm">Dirección<input name="Direccion" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Zona<input name="Zona" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Teléfono<input name="Telefono" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Teléfono de reservas<input name="TelefonoReservas" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Correo<input type="email" name="Correo" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Horario<input name="HorarioAtencion" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Sitio web<input type="url" name="SitioWeb" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm">Rango de precios<input name="RangoPrecios" placeholder="No disponible" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /></label><label class="text-sm sm:col-span-2">Platos principales<textarea name="PlatosPrincipales" rows="3" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2"></textarea></label><div class="sm:col-span-2"><button class="focus-ring rounded-lg bg-[#67254e] px-5 py-3 font-semibold text-[#fff8df] hover:bg-[#501d41]">Guardar información</button><span id="restaurant-message" class="ml-4 text-sm"></span></div></form></details>
      <div class="mt-9 grid gap-4 sm:grid-cols-3"><div class="rounded-xl bg-[#f3e2e8] p-5"><p class="text-sm text-[#81576d]">Total</p><strong id="total-count" class="mt-2 block text-3xl">—</strong></div><div class="rounded-xl bg-[#ead9b9]/60 p-5"><p class="text-sm text-[#81576d]">Disponibles</p><strong id="available-count" class="mt-2 block text-3xl">—</strong></div><div class="rounded-xl bg-[#ead6df] p-5"><p class="text-sm text-[#81576d]">Canceladas</p><strong id="cancelled-count" class="mt-2 block text-3xl">—</strong></div></div>
      <form id="filters" class="mt-8 grid gap-3 rounded-xl border border-[#e5cdd7] bg-white/60 p-4 sm:grid-cols-2 lg:grid-cols-6"><select name="estado" class="focus-ring rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2"><option value="">Todos los estados</option><option value="Disponible">Disponible</option><option value="Cancelado">Cancelado</option></select><input name="fecha" type="date" class="focus-ring rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /><input name="mesa" type="number" min="1" placeholder="Mesa" class="focus-ring rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /><input name="nombre" placeholder="Nombre del cliente" class="focus-ring rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /><input name="numero" placeholder="Teléfono" class="focus-ring rounded-lg border border-[#e5cdd7] bg-[#fff8df] px-3 py-2" /><button class="focus-ring rounded-lg bg-[#39152f] px-4 py-2 font-semibold text-[#fff8df] hover:bg-[#67254e]">Filtrar</button></form>
      <div id="message" class="mt-5 hidden rounded-lg p-4 text-sm"></div>
      <div class="mt-5 overflow-hidden rounded-xl border border-[#e5cdd7] bg-white"><div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="bg-[#f3e2e8] text-xs uppercase tracking-wider text-[#81576d]"><tr><th class="px-5 py-4">Cliente</th><th class="px-5 py-4">Teléfono</th><th class="px-5 py-4">Mesa</th><th class="px-5 py-4">Fecha</th><th class="px-5 py-4">Estado</th><th class="px-5 py-4">Acción</th></tr></thead><tbody id="reservas-body" class="divide-y divide-[#f0e1e5]"></tbody></table></div><div id="empty" class="hidden p-12 text-center text-[#81576d]">No hay reservas que coincidan con los filtros.</div></div>
    </section>
    <dialog id="reservation-dialog" class="w-[min(92vw,540px)] rounded-2xl border-0 bg-[#fff8df] p-0 text-[#39152f] shadow-2xl backdrop:bg-[#271022]/70"><form id="reservation-form" class="p-7"><div class="flex items-start justify-between"><div><p id="dialog-eyebrow" class="text-xs font-bold uppercase tracking-widest text-[#9a587d]">Nueva reserva</p><h2 class="mt-1 text-3xl">Preparar una mesa</h2></div><button id="close-dialog" type="button" class="text-2xl text-[#81576d]">×</button></div><input type="hidden" name="id" /><div class="mt-6 grid gap-4 sm:grid-cols-2"><label class="text-sm sm:col-span-2">Nombre del cliente<input required name="NombreCliente" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-white px-3 py-2" /></label><label class="text-sm">Teléfono<input required name="NumeroCliente" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-white px-3 py-2" /></label><label class="text-sm">Número de mesa<input required min="1" type="number" name="NumeroMesa" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-white px-3 py-2" /></label><label class="text-sm">Estado<select name="EstadoPedido" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-white px-3 py-2"><option>Disponible</option><option>Cancelado</option></select></label><label class="text-sm">Fecha y hora<input type="datetime-local" name="FechaReserva" class="focus-ring mt-1 w-full rounded-lg border border-[#e5cdd7] bg-white px-3 py-2" /></label></div><p id="form-error" class="mt-4 hidden rounded-lg bg-red-50 p-3 text-sm text-red-700"></p><button class="focus-ring mt-6 w-full rounded-lg bg-[#67254e] px-4 py-3 font-semibold text-[#fff8df] hover:bg-[#501d41]">Guardar reserva</button></form></dialog>
  </main>
  <script>
    import { isAuthenticated, getAdministrator, logout } from '../../services/auth.service'
    import { createReserva, listReservas, updateReserva } from '../../services/reservas.service'
    import { getRestaurante, updateRestaurante } from '../../services/restaurante.service'
    import { escapeHtml, formatDate } from '../../utils/format'
    import type { Reserva } from '../../types/api'

    if (!isAuthenticated()) window.location.replace('/login')
    const admin = getAdministrator()
    document.querySelector('#admin-name')!.textContent = admin ? `Hola, ${admin.Usuario}` : ''
    const body = document.querySelector<HTMLTableSectionElement>('#reservas-body')!
    const empty = document.querySelector<HTMLElement>('#empty')!
    const message = document.querySelector<HTMLElement>('#message')!
    const dialog = document.querySelector<HTMLDialogElement>('#reservation-dialog')!
    const form = document.querySelector<HTMLFormElement>('#reservation-form')!
    const restaurantForm = document.querySelector<HTMLFormElement>('#restaurant-form')!
    let current: Reserva[] = []
    const loadRestaurant = async () => { try { const { data } = await getRestaurante(); for (const key of ['Nombre', 'TipoComida', 'Descripcion', 'Direccion', 'Zona', 'Telefono', 'TelefonoReservas', 'Correo', 'HorarioAtencion', 'SitioWeb', 'RangoPrecios', 'PlatosPrincipales']) { const field = restaurantForm.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement; if (field) field.value = String(data[key as keyof typeof data] ?? '') } } catch (error) { document.querySelector('#restaurant-message')!.textContent = error instanceof Error ? error.message : 'No fue posible cargar los datos' } }

    const showMessage = (text: string, error = false) => { message.textContent = text; message.className = `mt-5 rounded-lg p-4 text-sm ${error ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}` }
    const render = (items: Reserva[]) => {
      current = items
      document.querySelector('#total-count')!.textContent = String(items.length)
      document.querySelector('#available-count')!.textContent = String(items.filter((r) => r.EstadoPedido === 'Disponible').length)
      document.querySelector('#cancelled-count')!.textContent = String(items.filter((r) => r.EstadoPedido === 'Cancelado').length)
      empty.classList.toggle('hidden', items.length > 0)
      body.innerHTML = items.map((r) => `<tr><td class="px-5 py-4 font-semibold">${escapeHtml(r.NombreCliente)}</td><td class="px-5 py-4">${escapeHtml(r.NumeroCliente)}</td><td class="px-5 py-4">Mesa ${r.NumeroMesa}</td><td class="px-5 py-4">${escapeHtml(formatDate(r.FechaReserva))}</td><td class="px-5 py-4"><span class="rounded-full px-3 py-1 text-xs font-semibold ${r.EstadoPedido === 'Disponible' ? 'bg-[#ead9b9] text-[#725229]' : 'bg-[#f1d6df] text-[#8b3d62]'}">${r.EstadoPedido}</span></td><td class="px-5 py-4"><button data-edit="${r.Identificador}" class="font-semibold text-[#67254e] underline">Editar</button></td></tr>`).join('')
    }
    const load = async () => { try { const data = new FormData(document.querySelector<HTMLFormElement>('#filters')!); const result = await listReservas({ estado: String(data.get('estado') || '') as 'Disponible' | 'Cancelado' | undefined, fecha: String(data.get('fecha') || ''), mesa: String(data.get('mesa') || ''), nombre: String(data.get('nombre') || ''), numero: String(data.get('numero') || '') }); render(result.data); message.classList.add('hidden') } catch (error) { showMessage(error instanceof Error ? error.message : 'No fue posible cargar las reservas', true) } }
    document.querySelector('#filters')!.addEventListener('submit', (e) => { e.preventDefault(); void load() })
    document.querySelector('#new-reservation')!.addEventListener('click', () => { form.reset(); (form.elements.namedItem('id') as HTMLInputElement).value = ''; document.querySelector('#dialog-eyebrow')!.textContent = 'Nueva reserva'; dialog.showModal() })
    document.querySelector('#close-dialog')!.addEventListener('click', () => dialog.close())
    body.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-edit]'); if (!button) return; const item = current.find((r) => r.Identificador === Number(button.dataset.edit)); if (!item) return; for (const key of ['NombreCliente', 'NumeroCliente', 'NumeroMesa', 'EstadoPedido']) (form.elements.namedItem(key) as HTMLInputElement).value = String(item[key as keyof Reserva]); (form.elements.namedItem('id') as HTMLInputElement).value = String(item.Identificador); document.querySelector('#dialog-eyebrow')!.textContent = 'Editar reserva'; dialog.showModal() })
    form.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const id = String(data.get('id')); const input = { NombreCliente: String(data.get('NombreCliente')), NumeroCliente: String(data.get('NumeroCliente')), NumeroMesa: Number(data.get('NumeroMesa')), EstadoPedido: String(data.get('EstadoPedido')) as 'Disponible' | 'Cancelado', ...(data.get('FechaReserva') ? { FechaReserva: new Date(String(data.get('FechaReserva'))).toISOString() } : {}) }; try { if (id) await updateReserva(Number(id), input); else await createReserva(input); dialog.close(); showMessage(id ? 'Reserva actualizada correctamente.' : 'Reserva registrada correctamente.'); await load() } catch (error) { const target = document.querySelector<HTMLElement>('#form-error')!; target.textContent = error instanceof Error ? error.message : 'No fue posible guardar la reserva'; target.classList.remove('hidden') } })
    document.querySelector('#logout')!.addEventListener('click', async () => { try { await logout() } finally { window.location.assign('/login') } })
    restaurantForm.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(restaurantForm); const input = Object.fromEntries([...data.entries()].map(([key, value]) => [key, String(value)])); try { await updateRestaurante(input); document.querySelector('#restaurant-message')!.textContent = 'Información guardada.' } catch (error) { document.querySelector('#restaurant-message')!.textContent = error instanceof Error ? error.message : 'No fue posible guardar la información' } })
    void loadRestaurant()
    void load()
  </script>
</BaseLayout>
